    {"id":"restore-text","type":"text","x":635,"y":635,"width":250,"height":140,"text":"4. ANSWER / DISPLAY\nFinal PII scan + validation\nReveal: decrypt source tokens\nHide: same protected answer","fontSize":16,"fontFamily":2,"strokeColor":"#000000"},
