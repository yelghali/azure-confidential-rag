    {"id":"protect","type":"rectangle","x":300,"y":360,"width":260,"height":160,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid"},
    {"id":"protect-text","type":"text","x":315,"y":380,"width":230,"height":135,"text":"2. QUESTION PII\nBackend calls Azure PII\nREDACTED markers\nNo question-value map","fontSize":16,"fontFamily":2,"strokeColor":"#000000"},
