    {"id":"vault","type":"rectangle","x":300,"y":620,"width":260,"height":160,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid"},
    {"id":"vault-text","type":"text","x":315,"y":635,"width":230,"height":140,"text":"SQLite mapping DB\nToken -> encrypted original\nCollection + doc version\nKey: RAG_MAPPING_KEY","fontSize":16,"fontFamily":2,"strokeColor":"#000000"},
