# Default is an explicitly labelled, synthetic-only local extractive demo.
# It does NOT run Azure, an LLM, or production PII recognition.
RAG_MODE=demo
RAG_DATA_DIR=.data
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in Azure mode; keep stable across restarts. Store via Key Vault in a deployment.
RAG_MAPPING_KEY=
# Required in Azure mode: independent random secrets, at least 32 characters each.
RAG_APP_KEY=
RAG_SKILL_KEY=

# Azure mode uses existing resources. Run python -m scripts.provision after configuration.
RAG_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
RAG_SEARCH_API_VERSION=2026-10-01
RAG_PROJECT_ENDPOINT=https://YOUR-FOUNDRY.ai.azure.com/api/projects/YOUR-PROJECT
RAG_MODEL_DEPLOYMENT=gpt-4.1-mini
RAG_LANGUAGE_ENDPOINT=https://YOUR-LANGUAGE.cognitiveservices.azure.com
RAG_LANGUAGE_API_VERSION=2025-11-01
RAG_PII_PROVIDER=azure
# Alternative: presidio; this endpoint is server-configured, never supplied by a document.
RAG_PRESIDIO_ENDPOINT=http://127.0.0.1:5002
RAG_BLOB_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
RAG_STORAGE_RESOURCE_ID=/subscriptions/YOUR-SUB/resourceGroups/YOUR-RG/providers/Microsoft.Storage/storageAccounts/YOUR-STORAGE
# Public HTTPS backend URL reachable by Search; protect /api/skill with RAG_SKILL_KEY.
# For a real deployment, place behind authenticated ingress and configure private connectivity.
RAG_SKILL_BASE_URL=https://YOUR-API.example
RAG_OPENAI_ENDPOINT=https://YOUR-OPENAI.openai.azure.com
RAG_EMBEDDING_DEPLOYMENT=text-embedding-3-small
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
